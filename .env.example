# Data Source Mode: 'excel' or 'sheets'
DATA_SOURCE=excel

# Local Excel Configuration
EXCEL_INPUT_PATH=Test.xlsx
EXCEL_INPUT_SHEET="Client Details"
EXCEL_OUTPUT_SHEET="Succesful Signuos"

# Google Sheets Configuration
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/17ohWhpYEER6nKaWz65FjfS95nX6JI61zHUBFbG7e27c/edit?usp=sharing
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# Browser Configuration
BROWSER_HEADLESS=false
BROWSER_SLOW_MO_MS=100
BROWSER_TIMEOUT_MS=20000

# Logging & Tracing
LOG_LEVEL=INFO
ENABLE_PLAYWRIGHT_TRACE=false

# Processing Defaults
DAILY_CLIENT_LIMIT=20
AUTO_VERIFY_LOGIN=true

